function cfg = config()
% CONFIG  Simulation and controller parameters

%% Robots and dynamics
cfg.numRobots = 5;      % number of robots
cfg.dt        = 0.1;    % [s]
cfg.simTime   = 90.0;   % [s]
cfg.maxSpeed  = 0.4;    % [m/s] single-integrator speed cap

%% World / map
cfg.worldRadius    = 5.0;    % circumscribed radius of octagon [m]
cfg.mapResolution  = 0.05;   % [m/cell]
cfg.mapSize        = 200;    % cells per side
cfg.unknown        = -1;
cfg.freeVal        = 0;
cfg.occVal         = 1;

cfg.mapID          = 5;      % which obstacle layout to use

%% Lidar
cfg.lidarMaxRange     = 3.0;    % [m]
cfg.lidarNumBeams  = 360;    % beams over 360 deg
cfg.lidarStep      = 0.05;   % ray marching step [m]
cfg.lidarStd       = 0.0;    % noise (0 = none)

%% Potential-field controller parameters

% Pairwise collision / dispersion
cfg.d_min      = 0.6;       % safety distance between robots [m]
cfg.d_far      = 4.0;       % beyond this, pairwise term ~0
cfg.k_pair     = 0.8;       % pairwise potential gain

% Boundary (workspace) barrier
cfg.d_wall     = 0.3;       % minimum distance to wall
cfg.k_wall     = 1.0;       % wall barrier gain

% Obstacle barrier
cfg.d_obs      = 0.3;       % minimum distance to obstacles
cfg.k_obs      = 1.0;       % obstacle barrier gain

% Connectivity barrier (keep distances below R_conn)
cfg.R_conn     = 3.5;       % communication radius [m]
cfg.k_conn     = 0.2;       % connectivity barrier gain
cfg.commRange  = cfg.R_conn;  % used in computeConnectivity

% MST chain spacing (spread robots along the connectivity backbone)
cfg.k_chain   = 0.15;             % gain for Φ_chain (0.1–0.3 works)
cfg.d_chain   = 0.6 * cfg.R_conn; % desired edge length along the tree


% Dispersion / ring potential
cfg.r0         = 3.8;       % desired radius from origin [m]
cfg.k_disp     = 0.1;       % dispersion gain (weak compared to safety)

% Gradient descent gain
cfg.k_grad     = 1.0;

% Rotational exploration gain (orthogonal to gradPhi)
cfg.k_rot      = 0.4;   % 0 means no swirl

%% Exploration / entropy field on global occupancy grid (Φ_entropy)
cfg.useExplorationField = true;
cfg.weightUnknown       = 1.0;   % unknown cells attractive
cfg.weightFree          = 0.1;   % free but known: weak
cfg.weightOcc           = 0.0;   % obstacles not attractive

cfg.exploreKernelRadius = 4;     % [cells] radius of Gaussian kernel
cfg.exploreKernelSigma  = 2.0;   % [cells] sigma for smoothing

% Gain for exploration potential Φ_entropy = -k_exploreField * E(x)
cfg.k_exploreField      = 0.8;

% Leader-follower exploration structure
cfg.leaderID            = 1;    % robot index that acts as leader
cfg.leaderExploreFactor = 2.0;  % leader has 2x exploration gain

%% Stay / anti-stuck field (Φ_stay based on time-in-region)
cfg.useStayField        = true;
cfg.k_stayField         = 0.8;   % gain for Φ_stay = k_stayField * S(x)

%% Plotting / diagnostics
cfg.livePlotEvery = 10;     % plot every N steps

end
